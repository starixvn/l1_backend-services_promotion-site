{
    "name": "project1",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "prebuild": "rimraf dist",
        "build:webpack": "webpack --mode production",
        "build": "npm run build:webpack && nest build",
        "watch:webpack": "webpack --mode development --watch",
        "watch:nest": "nest start --watch",
        "watch:all": "npm run prebuild && concurrently \"npm run watch:webpack\" \"nest start\"",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "concurrently \"npm run build:webpack\" \"nest start\"",
        "start:dev": "npm run watch:all",
        "start:nest": "nest start",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,views,libs,test}/**/*.{ts, tsx}\" --fix",
        "test": "jest ./__test__/unit-tests --config ./jest-config.json",
        "test-file": "jest leader-boards.service.test.ts --config ./jest-config.json",
        "test-coverage": "jest ./__test__/unit-tests --config ./jest-config.json --collect-coverage",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "integration-test": "jest ./__test__/integration-tests --config ./jest-config.json --maxWorkers=1 --forceExit",
        "integration-test-dev": "jest ./__test__/integration-tests --config ./jest-config.dev.json --maxWorkers=1 --forceExit",
        "integration-test-file-dev": "jest promotion-config.test.ts --config ./jest-config.dev.json --maxWorkers=1 --forceExit",
        "reg": "npm set registry https://npm.lumigame.com/",
        "clean:ts": "npx rimraf node_modules/.cache/ts-loader"
    },
