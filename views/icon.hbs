<html>

    <head>
        <meta charset='utf-8' />
        <title>Promotion Site</title>
    </head>

    <body>
        <a id='icon' target='_blank' rel='noopener noreferrer'>
            <img src='static/images/promotion-2.png' />
        </a>

        <script type='text/javascript'>
            const a = document.getElementById('icon'); const queryString = new URLSearchParams(window.location.search).toString();
            a.setAttribute('href', `./?${queryString}`);
        </script>
    </body>

</html>