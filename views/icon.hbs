<html>

    <head>
        <meta charset='utf-8' />
        <title>Promotion Site</title>
    </head>

    <style>
        body.icon-container{ margin: 0; height: 100%; } a#icon{ position: absolute; height: inherit; } img.icon-img{ height: inherit; }
    </style>

    <body class='icon-container'>
        <a id='icon' target='_blank' rel='noopener noreferrer'>
            <img src='static/images/promotion-2.png' class='icon-img' />
        </a>

        <script type='text/javascript'>
            const a = document.getElementById('icon'); const queryString = new URLSearchParams(window.location.search).toString();
            a.setAttribute('href', `./?${queryString}`);
        </script>
    </body>

</html>