<html>

<head>
    <meta charset='utf-8' />
    <title>Promotion Site</title>
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <style>
        body.icon-container {
            margin: 0;
            height: 100%;
        }

        a#icon {
            position: absolute;
            height: inherit;
        }

        img.icon-img {
            height: inherit;
        }
    </style>
</head>

<body class='icon-container'>
    <a id='icon' target='_blank' rel='noopener noreferrer'>
        <img src='static/images/icons/icon.gif' class='icon-img' />
    </a>

    <script type='text/javascript'>
        const a = document.getElementById('icon'); const queryString = new URLSearchParams(window.location.search).toString();
        a.setAttribute('href', `./?${queryString}`);
    </script>
</body>

</html>