<html>

    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width' />
        <meta name='apple-mobile-web-app-capable' content='yes' />
        <meta http-equiv='Cache-Control' content='no-cache, no-store, must-revalidate' />
        <title>Promotion Site</title>
        <link rel='icon' type='image/x-icon' href='static/images/icons/favicon-vg2.ico' />

        <link rel='preload' href='static/fonts/NotoSerif-Bold.woff' as='font' type='font/woff' crossorigin />
        <link rel='preload' href='static/fonts/NotoSerif-BoldItalic.woff' as='font' type='font/woff' crossorigin />
        <link rel='preload' href='static/fonts/NotoSerif-Italic.woff' as='font' type='font/woff' crossorigin />
        <link rel='preload' href='static/fonts/NotoSerif-Regular.woff' as='font' type='font/woff' crossorigin />
    </head>

    <body>
        <div id='root' class='main'></div>
        <script type='text/javascript'>
            var AppInitialState = JSON.parse('{{{jsonObject}}}');
        </script>
        <script type='module' src='bundle/index.js'></script>

        <script type='text/javascript'>
            if(window?.AppInitialState?.system === 1) { document.body.className ="saba-club"; } else if(window?.AppInitialState?.system ===
            2 || window?.AppInitialState?.system === 4) { document.body.className ="mega-keno"; } else { document.body.className ="others";
            }
        </script>
    </body>

</html>